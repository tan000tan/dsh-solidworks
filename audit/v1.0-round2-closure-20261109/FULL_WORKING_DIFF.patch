 def is_safe_to_dismiss(title: str, class_name: str = "#32770") -> Tuple[bool, str]:
+
     """
+
     绮剧‘鍒ゆ柇寮瑰嚭鐨勬ā鎬佸璇濇鏄惁鍙互琚?solidworks_recover 瀹夊叏鍙戦€?WM_CLOSE銆? 
+
+
     杩斿洖: (is_safe: bool, reason: str)
+
     - 涓ョ璇叧闂敤鎴锋鍦ㄧ紪杈戠殑绯荤粺閫夐」銆佹柟绋嬪紡銆佸彟瀛樹负绛夊叧閿晫闈紱
+
     - 浠呭闃绘柇鑷姩鍖栬繍琛岀殑閿欒銆佽鍛娿€佽鐩栨彁绀恒€佹ā鏉跨己澶卞璇濇鏀捐鍏抽棴锛?+
     - 鏈煡绫诲埆榛樿 Fail-Closed锛屽畨鍏ㄤ繚鐣欎笉寮哄叧銆?+
     """
+
     if class_name != "#32770":
+
         return False, f"闈炴爣鍑嗗璇濇绐楀彛绫?({class_name})锛岀姝㈠叧闂?
 
+
+
     title_clean = title.strip()
+
     if not title_clean:
+
         return False, "鏃犳爣棰樼獥鍙ｏ紝瀹夊叏淇濈暀"
 
+
+
     # 1. 鐢ㄦ埛鍏抽敭宸ヤ綔绐楀彛淇濇姢鐧藉悕鍗曪紙缁濆绂佹鍏抽棴锛?+
     for protected in PROTECTED_WINDOW_KEYWORDS:
+
         if protected.lower() in title_clean.lower():
+
             return False, f"鍛戒腑鐢ㄦ埛缂栬緫涓庤缃繚鎶ょ櫧鍚嶅崟 ('{protected}')锛岀姝㈠叧闂?
 
+
