+
+    # 鑻ュ叿澶囩墿鐞嗚矾寰勶紝蹇呴』澶勪簬娌欑鐧藉悕鍗曠洰褰曞唴锛屼弗绂佽秴鍑鸿竟鐣?+
+    if path_str and not validate_path_against_allowed_roots(path_str, allowed_roots):
+
+        return False
+
+
+
+    return True
