+def close_document(sw, doc_or_title, force_discard=False, allowed_roots=None) -> bool:
+
+    """
+
+    瀹夊叏鍏抽棴鎸囧畾 SolidWorks 鏂囨。銆?+
+    
+
+    涓夊眰闃插尽瀹夊叏杈圭晫锛?+
+    1. 鏍￠獙鐩爣闈炵┖锛岀姝㈢┖鍙傛暟瀵艰嚧璇叧褰撳墠娲诲姩鏂囨。锛?+
+    2. 涓ユ牸鏍搁獙璇佹。鎵€鏈夋潈锛堝繀椤诲睘浜庢湰浼氳瘽鍒涘缓鎴栧浜庢矙绠卞厑璁哥洰褰曪級锛岀粷涓嶅叧闂閮?鐢ㄦ埛鏂囨。锛?+
+    3. 鏍搁獙鏈繚瀛樼姸鎬侊紙GetSaveFlag锛夛紝鑻ユ湁鏈繚瀛樹慨鏀逛笖鏈樉寮忔寚瀹?force_discard=True锛屾嫆缁濆叧闂紱
+
+    4. 鍧氬喅绂佹璋冪敤 CloseAllDocuments銆?+
+    """
+
+    if doc_or_title is None:
+
+        return False
+
+
+
+    target_doc = None
+
+    target_title = ""
+
+    target_path = ""
+
+
+
+    if hasattr(doc_or_title, "GetTitle"):
+
+        target_doc = doc_or_title
+
+        try:
+
+            target_title = str(get_com_member(target_doc, "GetTitle") or "").strip()
+
+            target_path = str(get_com_member(target_doc, "GetPathName") or "").strip()
+
+        except Exception:
+
+            pass
+
+    elif isinstance(doc_or_title, str):
+
+        target_title = doc_or_title.strip()
+
+        if os.path.isabs(target_title):
+
+            target_path = target_title
+
+            target_title = os.path.basename(target_title)
+
+
+
+    if not target_title and not target_path:
+
+        return False
+
+
+
+    # 鑻ュ皻鏈幏鍙栫洰鏍囨枃妗ｅ璞★紝灏濊瘯浠?sw.GetDocuments() 涓牴鎹爣棰樻垨璺緞绮剧‘鍖归厤
+
+    if target_doc is None and sw is not None:
+
+        try:
+
+            docs = get_com_member(sw, "GetDocuments") or []
+
+            for d in docs:
+
+                dt = str(get_com_member(d, "GetTitle") or "").strip()
+
+                dp = str(get_com_member(d, "GetPathName") or "").strip()
+
+                is_title_match = bool(target_title and (dt == target_title or os.path.splitext(dt)[0] == os.path.splitext(target_title)[0]))
+                is_path_match = bool(target_path and dp and os.path.normcase(os.path.abspath(dp)) == os.path.normcase(os.path.abspath(target_path)))
+                if is_title_match or is_path_match:
+
+                    target_doc = d
+
+                    if not target_title:
+
+                        target_title = dt
+
+                    if not target_path:
+
+                        target_path = dp
+
+                    break
+
+        except Exception:
+
+            pass
+
+
+
+    # 绗簩灞傞槻绾匡細鎵€鏈夋潈涓庢矙绠辨牳楠?+
+    owned = is_document_owned(target_doc or target_title, target_path, allowed_roots)
+
+    if not owned:
+
+        raise PermissionError(
+
+            f"瀹夊叏杈圭晫鎷︽埅: 鏂囨。 '{target_title or target_path}' 鏈敱褰撳墠鑷姩鍖栦换鍔″垱寤猴紝涓斾笉鍦ㄥ厑璁哥殑娌欑鐩綍鍐咃紝涓ョ鍏抽棴鐢ㄦ埛鎴栧閮ㄦ枃妗ｏ紒"
+
+        )
+
+
+
+    # 绗笁灞傞槻绾匡細鏈繚瀛樹慨鏀规牳楠?+
+    if target_doc is not None:
+
+        try:
+
+            is_dirty = bool(get_com_member(target_doc, "GetSaveFlag"))
+
+            if is_dirty and not force_discard:
+
+                raise ValueError(
+
+                    f"瀹夊叏鎷︽埅: 鏂囨。 '{target_title}' 鍖呭惈鏈繚瀛樼殑淇敼銆備负淇濇姢璁捐鏁版嵁锛屽繀椤诲厛淇濆瓨鎴栨樉寮忔寚瀹?force_discard=True 鎵嶈兘鍏抽棴銆?
+
+                )
+
+        except Exception as e:
+
+            if isinstance(e, (PermissionError, ValueError)):
+
+                raise
+
+
+
+    # 鎵ц绮惧噯鍏抽棴
+
+    try:
+
+        title_to_close = target_title or (os.path.basename(target_path) if target_path else "")
+
+        if not title_to_close:
+
+            return False
+
+        get_com_member(sw, "CloseDoc", title_to_close)
+
+        # 浠庝細璇濈櫥璁伴泦涓敞閿€
+
+        if title_to_close in _SESSION_OWNED_DOCUMENTS:
+
+            _SESSION_OWNED_DOCUMENTS.discard(title_to_close)
+
+        if target_path and target_path in _SESSION_OWNED_DOCUMENTS:
+
+            _SESSION_OWNED_DOCUMENTS.discard(target_path)
+
+        return True
+
+    except Exception as exc:
+
+        if isinstance(exc, (PermissionError, ValueError)):
+
+            raise
+
+        return False
+
+
+
