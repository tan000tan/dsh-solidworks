     return False, "鏈槑纭瘑鍒负闃诲閿欒寮圭獥锛岄粯璁ゅ畨鍏ㄤ繚鐣?
 
 
+
+
+
 def _enumerate_solidworks_windows():
+
     """
+
     鏋氫妇 SolidWorks 椤跺眰绐楀彛锛屾壘鍑虹枒浼兼ā鎬佸璇濇銆? 
+
+
     杩斿洖 (main_window, dialogs)銆傛ā鎬佸璇濇鏄?COM 璋冪敤姘镐箙闃诲鐨勬牴鍥狅細SolidWorks
+
     鍦ㄧ瓑寰呯敤鎴风偣鍑绘椂涓嶄細鍝嶅簲 Automation 璋冪敤锛岃€屼笖涓嶄細瓒呮椂銆傝繖閲屽彧鏋氫妇鍜屾姤鍛婏紝
+
     榛樿涓嶄唬涓虹偣鍑烩€斺€旇嚜鍔ㄥ叧闂璇濇鍙兘涓㈠純鐢ㄦ埛灏氭湭淇濆瓨鐨勬洿鏀规垨鎺ュ彈閿欒鐨勬ā鏉裤€?+
     """
+
     try:
+
         import win32gui  # type: ignore
+
     except Exception:
+
         return None, [], "win32gui 涓嶅彲鐢紝鏃犳硶鏋氫妇绐楀彛锛坧ywin32 鏈畨瑁呮垨涓嶅畬鏁达級"
 
+
+
     dialogs = []
+
     main_window = None
 
+
+
     def visit(handle, _param):
+
         """@brief EnumWindows 鍥炶皟锛屾寜绐楀彛鏍囬褰掔被銆?""
+
         nonlocal main_window
+
         if not win32gui.IsWindowVisible(handle):
+
             return True
+
         title = win32gui.GetWindowText(handle)
+
         if not title:
+
             return True
+
         class_name = win32gui.GetClassName(handle)
+
         if "SolidWorks" in class_name and "SldWorks" in class_name:
+
             main_window = {"handle": handle, "title": title, "class": class_name}
+
             return True
+
         # SolidWorks 鐨勬ā鎬佹彁绀哄涓?#32770 鏍囧噯瀵硅瘽妗嗭紝鏍囬甯稿惈鐗堟湰鍙锋垨鍔熻兘鍚嶃€?+
         if class_name == "#32770" and (
+
             "SolidWorks" in title or "SOLIDWORKS" in title
+
         ):
+
             dialogs.append({"handle": handle, "title": title, "class": class_name})
+
         return True
 
+
+
     try:
+
         win32gui.EnumWindows(visit, None)
+
     except Exception as exc:
+
         return main_window, dialogs, f"鏋氫妇绐楀彛澶辫触: {exc}"
 
+
+
     return main_window, dialogs, None
 
 
