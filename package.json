{
  "name": "dsh-solidworks",
  "version": "0.5.0",
  "private": false,
  "description": "SolidWorks CAD tools for DeepSeek Harness: a policy-gated plugin that drives a local SolidWorks desktop through the bundled SolidWorks MCP server.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "dsh-solidworks": "./bin/dsh-solidworks.js"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "solidworks",
    "cad",
    "mcp"
  ],
  "license": "AGPL-3.0-only",
  "author": {
    "name": "tan000tan",
    "url": "https://github.com/tan000tan"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tan000tan/dsh-solidworks.git"
  },
  "homepage": "https://github.com/tan000tan/dsh-solidworks#readme",
  "bugs": {
    "url": "https://github.com/tan000tan/dsh-solidworks/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.12",
    "dsh": ">=0.1.7-rc.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "lib",
    "bin",
    "vendor",
    "!vendor/**/__pycache__/**",
    "!vendor/**/*.pyc",
    "!**/__pycache__/**",
    "!**/*.pyc",
    "docs",
    "!docs/audit_night_03/**",
    "!docs/overnight/**",
    "!docs/night_engineering_04/**",
    "!docs/night_engineering_05/**",
    "!docs/night_engineering_07/**",
    "!docs/extreme_engineering/**",
    "!docs/system_audit_01/**",
    "!docs/stage4_core_cad/**",
    "!docs/stage5_advanced_ai_cad/**",
    "!docs/drawing_research/**",
    "!docs/self_review_engine/**",
    "!docs/roadmap/**",
    "!docs/submission/**",
    "!docs/v030_*.md",
    "!docs/audit-and-hardening-v0.2.0.md",
    "!docs/final-release-readiness-v0.1.0.md",
    "!docs/phase4_cad_verification_report.md",
    "!docs/v0.2.0-release-plan.md",
    "!docs/发布前全项目文件夹清理报告.md",
    "scripts/setup.js",
    "scripts/doctor.js",
    "scripts/upgrade.js",
    "scripts/uninstall.js",
    "scripts/generate_mcp_config.js",
    "scripts/dsh_adapter.js",
    "requirements.txt",
    "requirements-optional.txt",
    "cordis.patch.yml",
    "dsh-plugin.json",
    "LICENSE",
    "NOTICE",
    "PROVENANCE.md",
    "README.md",
    "README.zh.md",
    "INSTALL.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "SUPPORT.md",
    "NOTICE.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "setup": "node scripts/setup.js",
    "doctor": "node scripts/doctor.js",
    "doctor:cli": "node bin/dsh-solidworks.js doctor",
    "upgrade": "node scripts/upgrade.js",
    "uninstall": "node scripts/uninstall.js",
    "mcp-config": "node scripts/generate_mcp_config.js",
    "list-tools": "node bin/dsh-solidworks.js list-tools",
    "selftest": "node bin/dsh-solidworks.js selftest",
    "test": "node tests/policy.test.js && node tests/mcp.test.js && node tests/schema.test.js && node tests/package.test.js",
    "test:audit": "node tests/audit.test.js",
    "test:host": "node tests/host.test.js",
    "test:crash": "node tests/crash.test.js",
    "test:package": "node tests/package.test.js",
    "probe": "node tests/probe-server.mjs",
    "write-loop": "node tests/write-loop.mjs",
    "test:all": "node scripts/run_test_all.mjs"
  }
}
